{
  "version": 1,
  "author": "Grupo Vinheria Agnello",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht1", "top": -90, "left": 150, "attrs": {} },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr1", "top": 120, "left": 230, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": 250, "left": 60, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 300, "left": 60, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],
    [ "dht1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "dht1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "dht1:SDA", "esp:D4", "blue", [ "v0" ] ],
    [ "ldr1:VCC", "esp:3V3", "red", [ "h0" ] ],
    [ "ldr1:GND", "esp:GND.1", "black", [ "h0" ] ],
    [ "ldr1:AO", "esp:D34", "purple", [ "h0" ] ],
    [ "esp:D2", "led1:A", "yellow", [ "h0" ] ],
    [ "led1:C", "r1:1", "black", [ "v0" ] ],
    [ "r1:2", "esp:GND.1", "black", [ "v0" ] ]
  ],
  "dependencies": {}
